# Copy to .env.local and fill in your own values. Never commit real keys.

# Supabase (Project Settings -> API). Required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Server-only: payments webhook, invite codes, email sign-ups.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack secret key (Dashboard -> Settings -> API Keys). Server-only.
PAYSTACK_SECRET_KEY=sk_test_xxx

# Public base URL, used for payment callbacks and share cards.
NEXT_PUBLIC_APP_URL=http://localhost:3000
